@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Core only. The library's JSON Schema validator is header-only and private
# to it, so a consumer needs nothing more.
find_dependency(Qt6 @PHOSPHORMCP_QT_MIN@ COMPONENTS Core)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorMcpTargets.cmake")

check_required_components(PhosphorMcp)

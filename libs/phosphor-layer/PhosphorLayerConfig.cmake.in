@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Keep the minimum Qt in sync with the top-level project — consumers
# running older Qt would otherwise fail later inside this library's
# headers with a confusing template / missing-symbol error rather than
# a clean find_package rejection at configure time.
find_dependency(Qt6 @PHOSPHORLAYER_QT_MIN@ COMPONENTS Core Gui Qml Quick)

# PhosphorLayer::Wayland (PhosphorWaylandTransport) exists only when the
# libraries were built with PHOSPHORLAYER_WITH_PHOSPHORWAYLAND. It links
# PhosphorWayland privately, which a shared library still names in its link
# interface, so the dependency is found here. The core PhosphorLayer target
# never links it. When OFF, consumers must NOT be forced to install it.
set(PhosphorLayer_WITH_PHOSPHORWAYLAND @PHOSPHORLAYER_WITH_PHOSPHORWAYLAND@)
if(PhosphorLayer_WITH_PHOSPHORWAYLAND)
    # PhosphorWayland and PhosphorLayer ship together in this tree, so a
    # version pin would chase the meta-version through every bump. Leave
    # unpinned but document that consumers mixing a system-installed
    # PhosphorWayland with an in-tree PhosphorLayer need to verify ABI.
    find_dependency(PhosphorWayland)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorLayerTargets.cmake")

check_required_components(PhosphorLayer)
